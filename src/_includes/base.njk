<!DOCTYPE html>
<html lang="en">
<head>
  <title>{% block custom_title %}Kevin.Gimbel.Dev/Ops{% endblock %}</title>
  <meta charset="UTF-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="generator" content="Eleventy">
  <link id="favicon" rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>{% if icon %}{{ icon }}{% else %}✪{% endif %}</text></svg>">
  <style>{% include "styles.css" %}</style>
  {% if custom_styles %}
  {% for style in custom_styles %}
  <style>{% include "" + custom_styles %}</style>
  {% endfor %}
  {% endif %}
  {% block head %}
  {% endblock %}
</head>
<body>
  <main>
    {% block content %}
    {% endblock %}
    <footer id="footer" class="[ footer ]">
      <div class="content">
        <p class="font-size-2">Hand-made with <a href="{% builder_meta "homepage" %}">{% builder_meta "name", "buildawesome" %}</a>@{% builder_meta "version" %}, <span onmouseover="this.textContent='💜';" onmouseout="this.textContent='🫀';" title="Love">🫀</span>, and lots of <span class="animation-spin">fun</span>.</p>
        <a href="/imprint" title="Imprint">Imprint</a>
        <p class="font-size--2">No AI was used in the creation of this 🔥 fire 🔥 website.</p>
      </div>
    </footer>
  </main>
</body>
<script>{% include "script.js" %}</script>
</html>
